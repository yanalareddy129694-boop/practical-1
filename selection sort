#include <iostream>
#include <vector>

void selectionSort(std::vector<int>& arr) {
    int n = arr.size();

    for (int i = 0; i < n - 1; ++i) {
        int minIdx = i; // Assume current element is smallest
        
        // Find index of smallest element in remaining unsorted array
        for (int j = i + 1; j < n; ++j) {
            if (arr[j] < arr[minIdx]) {
                minIdx = j;
            }
        }
        
        // Swap found minimum element with first unsorted element
        if (minIdx != i) {
            std::swap(arr[i], arr[minIdx]);
        }
    }
}

int main() {
    std::vector<int> numbers = {64, 25, 12, 22, 11};

    selectionSort(numbers);

    std::cout << "Sorted array: ";
    for (int num : numbers) {
        std::cout << num << " "; // Output: 11 12 22 25 64
    }
    std::cout << "\n";

    return 0;
}
